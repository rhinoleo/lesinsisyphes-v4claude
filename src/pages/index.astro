---
// Accueil (« actualité ») : mosaïque de tous les projets, du plus récent au plus ancien.
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Mosaique, { type Vignette } from '../components/Mosaique.vue';

const projets = (await getCollection('projets')).sort((a, b) => a.data.ordre - b.data.ordre);

const vignettes: Vignette[] = await Promise.all(
  projets.map(async (projet) => {
    const image = await getImage({ src: projet.data.vignetteAccueil });
    return {
      href: `/${projet.id}/`,
      titre: projet.data.titre,
      annee: projet.data.annee,
      src: image.src,
      largeur: projet.data.vignetteAccueil.width,
      hauteur: projet.data.vignetteAccueil.height,
    };
  }),
);
---

<Base classe="pt-[38px] pb-[53px]">
  <h1 class="sr-only">Les Insisyphes : actualité</h1>
  <Mosaique client:load vignettes={vignettes} />
</Base>
