---
// Gabarit unique des galeries photo : une page par fichier de src/content/galeries/.
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Galerie, { type Photo } from '../components/Galerie.vue';

export async function getStaticPaths() {
  const galeries = await getCollection('galeries');
  return galeries.map((galerie) => ({ params: { galerie: galerie.id }, props: { galerie } }));
}

const { galerie } = Astro.props;
const { titre, intitule, fil, retour, fond, photos } = galerie.data;

const fondOptimise = await getImage({ src: fond });

const photosPretes: Photo[] = await Promise.all(
  photos.map(async (photo) => {
    const grande = await getImage({ src: photo.image });
    // Vignette fournie, sinon carré recadré au centre (double densité pour les écrans fins).
    const vignette = photo.vignette
      ? await getImage({ src: photo.vignette })
      : await getImage({ src: photo.image, width: 100, height: 100, fit: 'cover' });
    return {
      src: grande.src,
      largeur: photo.image.width,
      hauteur: photo.image.height,
      vignette: vignette.src,
      tailleVignette: photo.vignette?.width ?? 50,
      titre: photo.titre,
      description: photo.description,
    };
  }),
);
---

<Base
  titre={titre}
  imagePartage={photos[0]?.image}
  description={`${titre} : galerie de ${photos.length} photos des Insisyphes.`}
  variante="noir"
  classe="px-[3px]"
>
  <div class="bg-bottom bg-no-repeat" style={`background-image:url(${fondOptimise.src})`}>
    <div class="px-3 pt-[15px] pb-[10px] md:pr-0 md:pl-5">
      <h1 class="font-titre mb-[30px] pb-[10px] text-[1.1em] leading-[1.5] font-normal tracking-[0.08em] text-[#ccc]">
        {fil.map((etape) => (
          <>
            <a href={etape.href}>{etape.titre}</a>
            {' > '}
          </>
        ))}
        {intitule}
        <br />
        <a href={retour}>&lt; retour</a>
      </h1>
      <Galerie client:load photos={photosPretes} />
    </div>
  </div>
</Base>
